# A2RL reference airframe, Elodin Gazebo-protocol SITL bridge.
defaults nosave
aux 0 0 0 1700 2100 0 0
set pid_process_denom = 1
set pwr_on_arm_grace = 0
set runaway_takeoff_prevention = OFF
set small_angle = 180
set failsafe_delay = 200
set yaw_motors_reversed = OFF
set rc_smoothing = OFF
set rates_type = ACTUAL
set roll_rc_rate = 32
set pitch_rc_rate = 32
set yaw_rc_rate = 20
set roll_srate = 32
set pitch_srate = 32
set yaw_srate = 20
set simplified_pids_mode = OFF
set p_roll = 12
set i_roll = 22
set d_roll = 0
set f_roll = 0
set p_pitch = 12
set i_pitch = 22
set d_pitch = 0
set f_pitch = 0
set p_yaw = 30
set i_yaw = 20
set d_yaw = 0
set f_yaw = 0
